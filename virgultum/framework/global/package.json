{
  "name": "@virgultum/global",
  "types": "./index.d.ts",
  "type": "module",
  "scripts": {
    "build": "yarn --cwd \"$PROJECT_CWD\" exec tsc -p \"$PWD/tsconfig.json\" --noEmit"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils/index.ts",
    "./env": "./src/env/index.ts",
    "./exceptions": "./src/exceptions/index.ts",
    "./di": "./src/di/index.ts",
    "./types": "./src/types/index.ts",
    "./gfx": "./src/gfx/index.ts",
    "./disposable": "./src/disposable/index.ts",
    "./lit": "./src/lit/index.ts"
  },
  "typesVersions": {
    "*": {
      "utils": [
        "dist/utils/index.d.ts"
      ],
      "env": [
        "dist/env/index.d.ts"
      ],
      "exceptions": [
        "dist/exceptions/index.d.ts"
      ],
      "di": [
        "dist/di/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ],
      "gfx": [
        "dist/gfx/index.d.ts"
      ],
      "disposable": [
        "dist/disposable/index.d.ts"
      ],
      "lit": [
        "dist/lit/index.d.ts"
      ]
    }
  },
  "author": "Myoxus Contributors",
  "license": "AGPL-3.0-or-later AND BSD-3-Clause AND MIT",
  "files": [
    "src",
    "dist",
    "index.d.ts",
    "!src/__tests__",
    "!dist/__tests__"
  ],
  "dependencies": {
    "@preact/signals-core": "^1.14.5",
    "lib0": "^0.2.119",
    "lit": "^3.3.3",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "version": "0.41.5"
}
