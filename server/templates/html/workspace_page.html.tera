{% if indexable %}{% set default_summary = "Myoxus Workspace" %}{% else %}{% set default_summary = "Collaborative workspace" %}{% endif %}<!doctype html><html><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{{ title | default(value="Myoxus Workspace") }}</title><meta property="og:title" content="{{ title | default(value="Myoxus Workspace") }}" /><meta name="description" content="{{ summary | default(value=default_summary) }}" /><meta property="og:description" content="{{ summary | default(value=default_summary) }}" />{% if avatar %}<meta property="og:image" content="{{ avatar }}" />{% endif %}{% if not indexable %}<meta name="robots" content="noindex" />{% endif %}</head><body><div id="app"></div></body></html>
