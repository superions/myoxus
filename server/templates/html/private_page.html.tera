<!doctype html><html lang="{{ html_lang_attr | safe }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{{ title }}</title>{% if portable_css %}<style data-myoxus-portable-theme>{{ portable_css | safe }}</style>{% else %}<link rel="stylesheet" href="{{ theme_css_url_attr | safe }}">{% endif %}<style>{{ public_css | safe }}</style></head><body{% if portable_css %} class="mx-private-export"{% endif %}>{{ body | safe }}</body></html>
