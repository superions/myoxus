{
  "name": "@myoxus/monorepo",
  "version": "0.42.3",
  "private": true,
  "author": "Myoxus Contributors",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    ".",
    "virgultum/**/*",
    "client/admin/workspaces/*",
    "client/web/workspaces/*",
    "client/apps/*",
    "client/libs/*",
    "tools/*",
    "tools/@types/*",
    "tests/client/*/*"
  ],
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "Myoxus": "r ./tools/cli/src/myoxus.ts",
    "myoxus": "r ./tools/cli/src/myoxus.ts",
    "af": "r ./tools/cli/src/myoxus.ts",
    "dev": "yarn myoxus dev",
    "build": "yarn myoxus build -p @myoxus/web --deps && yarn myoxus build -p @myoxus/admin --deps",
    "lint:icons": "yarn workspace @virgultum/icons check && yarn workspace @myoxus/icons check",
    "icons:review": "node tools/icon-review/server.mjs",
    "lint:prettier": "prettier --ignore-unknown --cache --check .",
    "lint:prettier:fix": "prettier --ignore-unknown --cache --write .",
    "lint:ox": "oxlint",
    "lint:ox:type-aware": "node build/scripts/ci/run-oxlint-type-aware.mjs",
    "lint:ox:fix": "yarn lint:ox --fix",
    "lint:docs:theme": "node build/scripts/docs/check-theme-doc-consistency.mjs",
    "lint": "yarn lint:icons && yarn lint:ox && yarn lint:ox:type-aware && yarn lint:prettier && yarn lint:docs:theme",
    "lint:fix": "yarn lint:ox:fix && yarn lint:prettier:fix",
    "docs:check": "python3 tools/check_docs_consistency.py",
    "security:policy:generate": "node build/scripts/ci/generate-security-policy.mjs",
    "security:policy:check": "node build/scripts/ci/generate-security-policy.mjs --check",
    "test": "bash build/scripts/test/run.sh --changed",
    "vitest": "node build/scripts/test/run-vitest-diagnostic.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b tsconfig.json --verbose",
    "preinstall": "node -e \"const major=Number(process.versions.node.split('.')[0]); if (!process.env.MYOXUS_IGNORE_NODE_VERSION && major !== 26) { console.error('Myoxus requires Node >=26.0.0 <27.0.0; current ' + process.version + '. Install the repository Node version through the approved host package source or set MYOXUS_IGNORE_NODE_VERSION=1 only for emergency lockfile maintenance.'); process.exit(1); }\"",
    "postinstall": "yarn myoxus init && yarn husky",
    "branding:theme-catalog": "yarn workspace @myoxus-tools/cli exec tsx ../../build/scripts/branding/export-theme-catalog.mjs",
    "branding:theme-catalog:check": "yarn workspace @myoxus-tools/cli exec tsx ../../build/scripts/branding/export-theme-catalog.mjs --check",
    "branding:theme-db-cutover:check": "bash build/scripts/ci/verify-theme-db-cutover.sh",
    "branding:theme-font-materialization:check": "node build/scripts/branding/verify-theme-font-materialization.mjs",
    "database:operational-naming:check": "node build/scripts/ci/verify-database-operational-naming.mjs",
    "branding:theme-fallback": "node build/scripts/branding/export-client-theme-fallback.mjs",
    "branding:theme-fallback:check": "node build/scripts/branding/export-client-theme-fallback.mjs --check",
    "branding:brand-identity-fallback": "node build/scripts/branding/export-brand-identity-fallback.mjs",
    "branding:brand-identity-fallback:check": "node build/scripts/branding/export-brand-identity-fallback.mjs --check",
    "frontend:no-vanilla-extract:report": "node build/scripts/ci/verify-no-vanilla-extract.mjs --report",
    "frontend:no-vanilla-extract:check": "node build/scripts/ci/verify-no-vanilla-extract.mjs --check",
    "frontend:ui-framework-graph:report": "node build/scripts/ci/verify-ui-framework-dependency-graph.mjs --report",
    "frontend:ui-framework-graph:check": "node build/scripts/ci/verify-ui-framework-dependency-graph.mjs --check",
    "frontend:ui-framework-graph:final-check": "node build/scripts/ci/verify-ui-framework-dependency-graph.mjs --final-check",
    "frontend:no-direct-svg:report": "node build/scripts/ci/verify-no-direct-product-svg.mjs --report",
    "frontend:no-direct-svg:check": "node build/scripts/ci/verify-no-direct-product-svg.mjs --check",
    "frontend:admin-ui-facade:report": "node build/scripts/ci/verify-admin-ui-facade.mjs --report",
    "frontend:admin-ui-facade:docs-check": "node build/scripts/ci/verify-admin-ui-facade.mjs --docs-check",
    "frontend:admin-ui-facade:final-check": "node build/scripts/ci/verify-admin-ui-facade.mjs --final-check",
    "frontend:admin-ui-dependency-graph:report": "node build/scripts/ci/verify-admin-ui-dependency-graph.mjs --report",
    "frontend:admin-ui-dependency-graph:check": "node build/scripts/ci/verify-admin-ui-dependency-graph.mjs --check",
    "frontend:container-isolation:check": "node build/scripts/ci/verify-frontend-container-isolation.mjs",
    "test:quality-audit": "node build/scripts/ci/audit-test-quality.mjs --report",
    "test:quality-ratchet": "node build/scripts/ci/audit-test-quality.mjs --ratchet --check-budgets",
    "test:rust-quality-ratchet": "node build/scripts/test/rust-quality-ratchet.mjs --check-budgets --json >/dev/null",
    "test:runtime-summary": "node build/scripts/test/summarize-runs.mjs --write-report",
    "virgultum:package-builds:check": "bash build/scripts/ci/check-virgultum-package-builds.sh",
    "frontend:css-reduction:report": "node build/scripts/ci/report-frontend-css-typography-inventory.mjs --mode=css",
    "frontend:css-variables:report": "node build/scripts/ci/report-frontend-css-typography-inventory.mjs --mode=variables",
    "frontend:facade-reduction:report": "node build/scripts/ci/verify-frontend-facade-reduction.mjs --report",
    "frontend:facade-reduction:final-check": "node build/scripts/ci/verify-frontend-facade-reduction.mjs --final-check",
    "frontend:typography:report": "node build/scripts/ci/report-frontend-css-typography-inventory.mjs --mode=typography",
    "frontend:css-typography:report": "node build/scripts/ci/report-frontend-css-typography-inventory.mjs --mode=both",
    "frontend:migration:dev": "bash build/scripts/server/frontend-dev-ensure.sh",
    "frontend:migration:cycle": "bash build/scripts/server/frontend-migration-cycle.sh",
    "frontend:migration:status": "bash build/scripts/server/frontend-migration-status.sh",
    "frontend:migration:audit": "bash build/scripts/server/frontend-migration-status.sh",
    "frontend:migration:gates": "bash build/scripts/server/frontend-migration-gates.sh",
    "frontend:migration:slice": "bash build/scripts/server/frontend-migration-slice.sh",
    "frontend:migration:workstep": "bash build/scripts/server/frontend-migration-workstep.sh",
    "frontend:migration:commit-push": "bash build/scripts/server/frontend-migration-commit-push.sh",
    "frontend:migration:clean": "bash build/scripts/server/frontend-migration-clean-generated.sh",
    "frontend:migration:context": "bash build/scripts/server/frontend-migration-context.sh",
    "frontend:migration:scope-audit": "bash build/scripts/server/frontend-migration-scope-audit.sh",
    "frontend:migration:slice-check": "bash build/scripts/server/frontend-migration-slice-check.sh",
    "frontend:migration:slice-review": "bash build/scripts/server/frontend-migration-slice-review.sh",
    "frontend:migration:visual": "bash build/scripts/server/frontend-migration-visual.sh",
    "frontend:theme-boundary:report": "node build/scripts/ci/verify-frontend-theme-boundary.mjs --report",
    "frontend:theme-boundary:guard": "node build/scripts/ci/verify-frontend-theme-boundary.mjs --report --max-findings=0 --max-rule:raw-css-color-literal=0 --max-rule:raw-jsx-color-prop=0 --max-rule:raw-style-color-literal=0 --max-rule:retired-admin-tone-boundary=0",
    "frontend:theme-boundary:check": "node build/scripts/ci/verify-frontend-theme-boundary.mjs --check"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown --cache",
    "*.{ts,tsx,mjs,js,jsx}": [
      "oxlint --fix"
    ],
    "{*.toml,!(vendor)/**/*.toml}": [
      "taplo format"
    ],
    "{*.rs,!(vendor)/**/*.rs}": [
      "cargo fmt --"
    ]
