# Keep overrides minimal: use /opt/myoxus/config/local.yaml for non-sensitive
# runtime configuration and protected files for the two allowlisted secrets.
RUN_MODE=production
MYOXUS__CONFIG__WRITEBACK_PATH=/opt/myoxus/config/local.yaml
MYOXUS__DATABASE__URL_FILE=/etc/myoxus/database-url
MYOXUS__CRYPTO__PRIVATE_KEY_FILE=/etc/myoxus/crypto-private-key

# Optional hard overrides (normally not needed when local.yaml is present):
# MYOXUS__REDIS__URL=redis://127.0.0.1:6379
# MYOXUS__STORAGE__BACKEND=local
# MYOXUS__STORAGE__ROOT=/opt/myoxus/storage
# MYOXUS__SERVER__ORIGIN=https://myoxus.example.com
# MYOXUS__LOGGING__FILE_PATH=/opt/myoxus/logs/myoxus.log
