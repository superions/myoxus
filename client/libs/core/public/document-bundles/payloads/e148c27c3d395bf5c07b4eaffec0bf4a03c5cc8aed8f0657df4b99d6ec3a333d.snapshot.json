            "flavour": "myoxus:paragraph",
            "version": 1,
            "props": {
              "type": "text",
              "collapsed": false,
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "Write a note, organise your text and discuss a passage with others. These are the controls you need to get started."
                  }
                ]
              },
              "meta:updatedAt": 1792406369711,
              "meta:updatedBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf",
              "meta:createdAt": 1792406369711,
              "meta:createdBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf"
            },
            "children": []
          },
          {
            "type": "block",
            "id": "mcp-block-2822ab2119da4e90b42b75ddde0e2167",
            "flavour": "myoxus:image",
            "version": 1,
            "props": {
              "width": 394,
