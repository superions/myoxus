            "version": 1,
            "props": {
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "Gardez une trace de ce qu’il faut faire, de la personne qui s’en charge et de l’échéance. La rubrique Tâches regroupe les tâches de votre espace de travail et des projets auxquels vous avez accès."
                  }
                ]
              },
              "type": "text",
              "collapsed": false,
              "meta:updatedAt": 1792410262885,
              "meta:updatedBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf",
              "meta:createdAt": 1792410262885,
              "meta:createdBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf"
            },
            "children": []
          },
          {
            "type": "block",
            "id": "mcp-block-33eca3f07cd04bb2b36f9a64bbb26907",
            "flavour": "myoxus:image",
            "version": 1,
            "props": {
              "sourceId": "assets/f51bd5c25790e05840581ddeafdf99bbc099ef549c42942dd490345c87618282",
              "caption": "Myoxus vous aide à garder vos tâches en vue.",
