            "flavour": "myoxus:paragraph",
            "version": 1,
            "props": {
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "Pour les listes, tableaux, images et déplacements de sections, consultez « Éditeur · Blocs et structure ». Pour vos fichiers existants, ouvrez « Importer vos contenus »."
                  }
                ]
              },
              "type": "text",
              "collapsed": false,
