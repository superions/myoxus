            "props": {
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "Rédigez une note, structurez votre texte et échangez sur un passage. Voici les commandes utiles pour commencer."
                  }
                ]
              },
              "type": "text",
              "collapsed": false,
              "meta:updatedAt": 1792406377576,
