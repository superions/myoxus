              "collapsed": false,
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "Busca tareas por su título y acota los resultados con los filtros. Quién puede leer una tarea depende de su destino; Mis tareas es una vista filtrada."
                  }
                ]
              },
