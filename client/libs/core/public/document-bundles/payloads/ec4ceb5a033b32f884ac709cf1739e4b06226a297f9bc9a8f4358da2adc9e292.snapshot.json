              "meta:createdBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf"
            },
            "children": []
          },
          {
            "type": "block",
            "id": "mcp-block-6f80fe4636bb4f2a80654ea5aa3ca88e",
            "flavour": "myoxus:image",
            "version": 1,
            "props": {
              "sourceId": "assets/7b7be73766160a104236cd458441de468296862b029157087bf5251807866c1e",
              "caption": "Schritt für Schritt zu deinem ersten Dokument.",
              "width": 394,
              "height": 262.6640625,
              "index": "a0",
              "xywh": "[0,0,0,0]",
              "lockedBySelf": false,
              "rotate": 0,
              "size": -1,
              "meta:updatedAt": 1792404432732,
              "meta:updatedBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf",
