            "props": {
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "Schreibe eine Notiz, gliedere deinen Text und besprich eine Stelle mit anderen. Hier findest du die Bedienelemente für den Anfang."
                  }
                ]
              },
              "type": "text",
              "collapsed": false,
              "meta:updatedAt": 1792404400292,
              "meta:updatedBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf",
