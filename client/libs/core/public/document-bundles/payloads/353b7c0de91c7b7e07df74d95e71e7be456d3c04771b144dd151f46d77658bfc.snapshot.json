          },
          {
            "type": "block",
            "id": "mcp-block-5c1e8009924a4064a2de92bd273a1bca",
            "flavour": "myoxus:paragraph",
            "version": 1,
            "props": {
              "type": "text",
              "collapsed": false,
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "Search for tasks by title, then narrow the results with filters. Who can read a task depends on its destination; My tasks is a filtered view."
                  }
                ]
              },
              "meta:updatedAt": 1792410255741,
              "meta:updatedBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf",
              "meta:createdAt": 1792410255741,
              "meta:createdBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf"
            },
            "children": []
          },
          {
            "type": "block",
            "id": "mcp-block-9c371ed608054c4b93e6292581dd5ad8",
            "flavour": "myoxus:paragraph",
            "version": 1,
            "props": {
              "collapsed": false,
              "meta:updatedAt": 1792410255742,
              "meta:updatedBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf",
              "meta:createdAt": 1792410255742,
              "meta:createdBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf",
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "A checklist in a document is enough for ticking off small items. Create a task when you want to track responsibility, a due date or progress in the task overview.",
                    "attributes": {
                      "color": "var(--myoxus-text-highlight-foreground-teal)"
                    }
                  }
                ]
              },
              "type": "quote"
