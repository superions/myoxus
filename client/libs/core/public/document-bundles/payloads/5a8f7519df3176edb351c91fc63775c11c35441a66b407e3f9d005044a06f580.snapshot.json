        "children": [
          {
            "type": "block",
            "id": "mcp-block-b51ea3797c324a6aa41d8c68bd0df10d",
            "flavour": "myoxus:paragraph",
            "version": 1,
            "props": {
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "Halte fest, was zu tun ist, wer es übernimmt und bis wann. Unter Aufgaben laufen die Aufgaben aus deinem Workspace und den Projekten zusammen, auf die du Zugriff hast."
                  }
                ]
              },
              "type": "text",
              "collapsed": false,
              "meta:updatedAt": 1792410146425,
              "meta:updatedBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf",
              "meta:createdAt": 1792410146425,
              "meta:createdBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf"
            },
            "children": []
          },
          {
            "type": "block",
            "id": "mcp-block-cd7dd66886474d119b4afd1d4eab3180",
            "flavour": "myoxus:image",
            "version": 1,
            "props": {
              "sourceId": "assets/f51bd5c25790e05840581ddeafdf99bbc099ef549c42942dd490345c87618282",
              "caption": "Myoxus hilft dir, deine Aufgaben im Blick zu behalten.",
              "width": 390,
              "height": 260,
              "index": "a0",
              "xywh": "[0,0,0,0]",
              "lockedBySelf": false,
              "rotate": 0,
              "size": -1,
              "meta:updatedAt": 1792410189568,
