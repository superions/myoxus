            "flavour": "myoxus:paragraph",
            "version": 1,
            "props": {
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "Eine Checkliste im Dokument genügt zum Abhaken kleiner Punkte. Lege eine Aufgabe an, wenn du Zuständigkeit, Termin oder Fortschritt in der Aufgabenübersicht verfolgen möchtest.",
                    "attributes": {
                      "color": "var(--myoxus-text-highlight-foreground-teal)"
                    }
                  }
                ]
