            "version": 1,
            "props": {
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "05 · Die Übersicht nutzen",
                    "attributes": {
                      "color": "var(--myoxus-text-highlight-foreground-teal)"
                    }
                  }
                ]
              },
              "type": "h3",
              "collapsed": false
            },
            "children": []
          },
