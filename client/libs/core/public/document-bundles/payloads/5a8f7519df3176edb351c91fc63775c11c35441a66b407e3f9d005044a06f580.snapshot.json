                      {
                        "insert": "Alle Aufgaben, auf die du Zugriff hast."
                      }
                    ]
                  }
                }
              },
              "appearance": "ruled",
              "density": "compact"
            },
            "children": []
          },
          {
            "type": "block",
            "id": "mcp-block-4210c5c701514c0db6a28ad8b240f8d9",
            "flavour": "myoxus:paragraph",
            "version": 1,
            "props": {
              "text": {
                "$virgultum:internal:text$": true,
                "delta": [
                  {
                    "insert": "Über die Suche findest du Aufgaben anhand ihres Titels. Filter grenzen die Auswahl weiter ein. Wer eine Aufgabe lesen darf, richtet sich nach dem gewählten Ziel; „Meine Aufgaben“ ist eine gefilterte Ansicht."
                  }
                ]
              },
              "type": "text",
              "collapsed": false,
              "meta:updatedAt": 1792410146427,
              "meta:updatedBy": "fd7acd25-2184-46ca-8fe9-c1d2c70e7aaf",
              "meta:createdAt": 1792410146427,
