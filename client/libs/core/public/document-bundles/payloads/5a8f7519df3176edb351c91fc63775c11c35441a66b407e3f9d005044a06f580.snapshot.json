                },
                "row-0001:col-0001": {
                  "text": {
                    "$virgultum:internal:text$": true,
                    "delta": [
                      {
                        "insert": "Aufgaben, die dir zugewiesen sind."
                      }
                    ]
                  }
                },
                "row-0002:col-0000": {
                  "text": {
                    "$virgultum:internal:text$": true,
