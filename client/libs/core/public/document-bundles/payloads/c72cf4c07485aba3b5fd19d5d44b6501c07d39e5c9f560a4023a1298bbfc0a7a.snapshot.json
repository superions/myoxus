            "flavour": "myoxus:image",
            "version": 1,
            "props": {
              "sourceId": "assets/7b7be73766160a104236cd458441de468296862b029157087bf5251807866c1e",
              "caption": "Paso a paso hasta tu primer documento.",
              "width": 394,
              "height": 262.6640625,
