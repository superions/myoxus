{
  "name": "@myoxus/bpmn-editor",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "AGPL-3.0-or-later AND Apache-2.0 AND LicenseRef-OMG-BPMN",
  "exports": {
    ".": "./src/modeller.tsx",
    "./source": "./src/source.ts",
    "./preview": "./src/preview.ts"
  },
  "scripts": {
    "generate": "node --import tsx scripts/generate.ts",
    "generate:check": "node --import tsx scripts/generate.ts --check",
    "source:check": "yarn generate:check && tsc -p tsconfig.source.json",
    "build": "tsc -b tsconfig.json && tsc -p tsconfig.tools.json",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "node ../../../build/scripts/test/run-vitest-diagnostic.mjs run --config vitest.config.ts"
  },
  "dependencies": {
    "@myoxus/i18n": "workspace:*",
    "@myoxus/icons": "workspace:*",
    "@myoxus/ui-facade": "workspace:*",
    "@xmldom/xmldom": "^0.9.10",
    "@xyflow/react": "12.11.1",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "dompurify": "3.4.16",
    "immer": "^11.1.8",
    "lodash-es": "4.18.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^30.1.3",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
