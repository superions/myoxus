<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:tns="urn:myoxus:associations" id="Definitions" targetNamespace="urn:myoxus:associations">
 <process id="Process" name="Association directions and scopes">
  <laneSet id="Lanes"><lane id="Lane" name="Annotations"><flowNodeRef>A</flowNodeRef><flowNodeRef>B</flowNodeRef><flowNodeRef>C</flowNodeRef><flowNodeRef>Sub</flowNodeRef></lane></laneSet>
  <task id="A" name="Review"/><task id="B" name="Approve"/><task id="C" name="Deliver"/>
  <subProcess id="Sub" name="Nested notes"><task id="Child" name="Nested work"/><textAnnotation id="ChildNote"><text>Nested annotation</text></textAnnotation><association id="NestedAssociation" sourceRef="tns:Child" targetRef="tns:ChildNote" associationDirection="One"/></subProcess>
  <textAnnotation id="Note1"><documentation id="NoteDoc" textFormat="text/plain">Retain annotation identity</documentation><text>Undirected note</text></textAnnotation>
  <textAnnotation id="Note2" textFormat="text/plain"><text>Directed note</text></textAnnotation>
  <textAnnotation id="Note3"><text>Bidirectional note</text></textAnnotation>
  <association id="Undirected" sourceRef="tns:A" targetRef="tns:Note1"><documentation id="AssociationDoc">Keep lexical endpoints and DI</documentation></association>
  <association id="Directed" sourceRef="tns:Note2" targetRef="tns:B" associationDirection="One"/>
  <association id="Both" sourceRef="tns:C" targetRef="tns:Note3" associationDirection="Both"/>
  <association id="Reverse" sourceRef="tns:Note3" targetRef="tns:C" associationDirection="One"/>
 </process>
 <bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
  <bpmndi:BPMNShape id="LaneDI" bpmnElement="Lane" isHorizontal="true"><dc:Bounds x="20" y="20" width="1050" height="750"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="ADI" bpmnElement="A"><dc:Bounds x="100" y="100" width="180" height="100"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="BDI" bpmnElement="B"><dc:Bounds x="430" y="100" width="180" height="100"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="CDI" bpmnElement="C"><dc:Bounds x="760" y="100" width="180" height="100"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Note1DI" bpmnElement="Note1"><dc:Bounds x="100" y="310" width="210" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Note2DI" bpmnElement="Note2"><dc:Bounds x="430" y="310" width="210" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Note3DI" bpmnElement="Note3"><dc:Bounds x="760" y="310" width="240" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="SubDI" bpmnElement="Sub" isExpanded="true"><dc:Bounds x="100" y="470" width="820" height="240"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="ChildDI" bpmnElement="Child"><dc:Bounds x="150" y="550" width="180" height="100"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="ChildNoteDI" bpmnElement="ChildNote"><dc:Bounds x="600" y="550" width="220" height="80"/></bpmndi:BPMNShape>
  <bpmndi:BPMNEdge id="UndirectedDI" bpmnElement="Undirected"><di:waypoint x="190" y="200"/><di:waypoint x="190" y="260"/><di:waypoint x="190" y="310"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="DirectedDI" bpmnElement="Directed"><di:waypoint x="535" y="310"/><di:waypoint x="535" y="250"/><di:waypoint x="520" y="200"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="BothDI" bpmnElement="Both"><di:waypoint x="850" y="200"/><di:waypoint x="850" y="250"/><di:waypoint x="880" y="310"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="ReverseDI" bpmnElement="Reverse"><di:waypoint x="760" y="345"/><di:waypoint x="700" y="345"/><di:waypoint x="700" y="150"/><di:waypoint x="760" y="150"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="NestedDI" bpmnElement="NestedAssociation"><di:waypoint x="330" y="600"/><di:waypoint x="460" y="600"/><di:waypoint x="600" y="590"/></bpmndi:BPMNEdge>
 </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>
