 id="Definitions" name="Standard globals" targetNamespace="urn:myoxus:globals"
 exporter="Independent fixture" exporterVersion="7">
 <import importType="http://www.w3.org/2001/XMLSchema" location="types.xsd" namespace="urn:myoxus:globals"/>
 <itemDefinition id="Payload" structureRef="tns:ExternalPayload"/>
 <resource id="Reviewer" name="Reviewer"><resourceParameter id="Parameter" name="subject" type="tns:Payload" isRequired="true"/></resource>
 <process id="Process" name="Standard process">
  <documentation>Process documentation</documentation>
  <auditing id="Audit"><extensionElements><vendor:config mode="retain">A&#13;B</vendor:config></extensionElements></auditing>
  <monitoring id="Monitor"><documentation>Monitoring documentation</documentation></monitoring>
  <property id="Variable" name="Context" itemSubjectRef="tns:Payload"/>
  <startEvent id="Start"><outgoing>ToTask</outgoing></startEvent>
  <task id="Task" name="Review"><incoming>ToTask</incoming><outgoing>ToEnd</outgoing>
   <potentialOwner id="Owner" name="Reviewer"><resourceRef>tns:Reviewer</resourceRef><resourceParameterBinding id="Binding" parameterRef="tns:Parameter"><formalExpression id="Expression" language="urn:fixture:expression" evaluatesToTypeRef="tns:Payload">reviewer</formalExpression></resourceParameterBinding></potentialOwner>
  </task>
  <endEvent id="End"><incoming>ToEnd</incoming></endEvent>
  <sequenceFlow id="ToTask" sourceRef="Start" targetRef="Task"/>
  <sequenceFlow id="ToEnd" sourceRef="Task" targetRef="End"/>
 </process>
 <bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
  <bpmndi:BPMNShape id="StartDI" bpmnElement="Start"><dc:Bounds x="40" y="60" width="36" height="36"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="TaskDI" bpmnElement="Task"><dc:Bounds x="160" y="40" width="120" height="80"/><bpmndi:BPMNLabel><dc:Bounds x="164" y="65" width="110" height="25"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="EndDI" bpmnElement="End"><dc:Bounds x="360" y="60" width="36" height="36"/></bpmndi:BPMNShape>
  <bpmndi:BPMNEdge id="ToTaskDI" bpmnElement="ToTask"><di:waypoint x="76" y="78"/><di:waypoint x="120" y="78"/><di:waypoint x="160" y="80"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="ToEndDI" bpmnElement="ToEnd"><di:waypoint x="280" y="80"/><di:waypoint x="360" y="78"/></bpmndi:BPMNEdge>
 </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>
