<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:tns="urn:myoxus:groups" id="Definitions" targetNamespace="urn:myoxus:groups">
 <category id="Category" name="Review categories"><categoryValue id="SharedValue" value="Shared review"/><categoryValue id="OtherValue" value="Other category"/></category>
 <process id="Process" name="Shared graphical groups">
  <laneSet id="Lanes"><lane id="Lane" name="Group ownership"><flowNodeRef>A</flowNodeRef><flowNodeRef>B</flowNodeRef><flowNodeRef>Sub</flowNodeRef></lane></laneSet>
  <task id="A" name="Review A"/><task id="B" name="Review B"/>
  <subProcess id="Sub" name="Nested grouping"><task id="Child" name="Nested work"/><group id="NestedGroup" categoryValueRef="tns:OtherValue"/></subProcess>
  <group id="First" categoryValueRef="tns:SharedValue"><documentation id="FirstDoc">Graphical grouping does not own the enclosed task</documentation></group>
  <group id="Second" categoryValueRef="tns:SharedValue"/>
 </process>
 <bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
  <bpmndi:BPMNShape id="LaneDI" bpmnElement="Lane" isHorizontal="true"><dc:Bounds x="20" y="20" width="1040" height="760"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="FirstDI" bpmnElement="First"><dc:Bounds x="80" y="90" width="380" height="300"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="SecondDI" bpmnElement="Second"><dc:Bounds x="580" y="90" width="380" height="300"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="ADI" bpmnElement="A"><dc:Bounds x="180" y="220" width="180" height="100"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="BDI" bpmnElement="B"><dc:Bounds x="680" y="220" width="180" height="100"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="SubDI" bpmnElement="Sub" isExpanded="true"><dc:Bounds x="80" y="470" width="880" height="250"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="NestedGroupDI" bpmnElement="NestedGroup"><dc:Bounds x="130" y="520" width="700" height="170"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="ChildDI" bpmnElement="Child"><dc:Bounds x="510" y="560" width="180" height="100"/></bpmndi:BPMNShape>
 </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>
