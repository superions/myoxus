<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:tns="urn:myoxus:data-stores" xmlns:xsd="http://www.w3.org/2001/XMLSchema" id="Definitions" targetNamespace="urn:myoxus:data-stores">
 <itemDefinition id="Item" structureRef="xsd:string"/>
 <dataStore id="Store" name="Orders store" capacity="200" isUnlimited="false" itemSubjectRef="tns:Item"><documentation id="StoreDoc">Shared store metadata</documentation><dataState id="StoreState" name="Active"/></dataStore>
 <dataStore id="Archive" name="Archive"/>
 <process id="Process" name="Global data stores" xmlns:shared="urn:myoxus:data-stores">
  <dataStoreReference id="First" name="Open orders" dataStoreRef="shared:Store"><dataState id="RefState" name="Open"/></dataStoreReference>
  <dataStoreReference id="Unbound" name="Unbound store"/>
  <task id="Review" name="Read stored data"/>
  <subProcess id="Sub" name="Shared store in nested scope"><dataStoreReference id="Nested" name="Stored orders" dataStoreRef="shared:Store"><dataState id="NestedState" name="Closed"/></dataStoreReference></subProcess>
 </process>
 <bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
  <bpmndi:BPMNShape id="FirstDI" bpmnElement="First"><dc:Bounds x="100" y="120" width="160" height="120"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="UnboundDI" bpmnElement="Unbound"><dc:Bounds x="420" y="120" width="140" height="100"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="ReviewDI" bpmnElement="Review"><dc:Bounds x="740" y="130" width="180" height="100"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="SubDI" bpmnElement="Sub" isExpanded="true"><dc:Bounds x="100" y="380" width="820" height="290"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="NestedDI" bpmnElement="Nested"><dc:Bounds x="450" y="470" width="100" height="80"/></bpmndi:BPMNShape>
 </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>
