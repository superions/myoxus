<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:tns="urn:myoxus:event-subprocess" id="Definitions" targetNamespace="urn:myoxus:event-subprocess">
 <message id="Message" name="Request"/>
 <process id="Process" name="Event subprocess contexts">
  <laneSet id="Lanes"><lane id="Lane" name="Event ownership"><flowNodeRef>Host</flowNodeRef><flowNodeRef>EventScope</flowNodeRef><flowNodeRef>CompensationScope</flowNodeRef></lane></laneSet>
  <task id="Host" name="Main work"/>
  <subProcess id="EventScope" name="Message handler" triggeredByEvent="true">
   <documentation id="ScopeDoc">Keep hidden semantic and DI ownership</documentation>
   <startEvent id="Trigger" name="Message trigger" isInterrupting="false"><outgoing>ToWork</outgoing><messageEventDefinition id="MessageDefinition" messageRef="tns:Message"/></startEvent>
   <manualTask id="EventWork" name="Handle request"><incoming>ToWork</incoming><outgoing>ToEnd</outgoing></manualTask>
   <endEvent id="EventEnd"><incoming>ToEnd</incoming></endEvent>
   <sequenceFlow id="ToWork" sourceRef="Trigger" targetRef="EventWork"/>
   <sequenceFlow id="ToEnd" sourceRef="EventWork" targetRef="EventEnd"/>
  </subProcess>
  <subProcess id="CompensationScope" name="Compensation handler" triggeredByEvent="true">
   <startEvent id="CompensationTrigger"><compensateEventDefinition id="CompensationDefinition"/></startEvent>
   <task id="CompensationWork" name="Compensate"/>
  </subProcess>
 </process>
 <bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
  <bpmndi:BPMNShape id="LaneDI" bpmnElement="Lane" isHorizontal="true"><dc:Bounds x="20" y="20" width="1000" height="650"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="HostDI" bpmnElement="Host"><dc:Bounds x="80" y="70" width="180" height="100"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="EventScopeDI" bpmnElement="EventScope" isExpanded="true"><dc:Bounds x="80" y="250" width="500" height="280"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="TriggerDI" bpmnElement="Trigger"><dc:Bounds x="120" y="350" width="36" height="36"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="EventWorkDI" bpmnElement="EventWork"><dc:Bounds x="230" y="330" width="150" height="80"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="EventEndDI" bpmnElement="EventEnd"><dc:Bounds x="480" y="350" width="36" height="36"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="CompensationScopeDI" bpmnElement="CompensationScope" isExpanded="false"><dc:Bounds x="670" y="250" width="270" height="220"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="CompensationTriggerDI" bpmnElement="CompensationTrigger"><dc:Bounds x="710" y="310" width="36" height="36"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="CompensationWorkDI" bpmnElement="CompensationWork"><dc:Bounds x="760" y="350" width="150" height="80"/></bpmndi:BPMNShape>
  <bpmndi:BPMNEdge id="ToWorkDI" bpmnElement="ToWork"><di:waypoint x="156" y="368"/><di:waypoint x="190" y="368"/><di:waypoint x="230" y="370"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="ToEndDI" bpmnElement="ToEnd"><di:waypoint x="380" y="370"/><di:waypoint x="430" y="368"/><di:waypoint x="480" y="368"/></bpmndi:BPMNEdge>
 </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>
