{
  "name": "@myoxus/electron",
  "private": true,
  "version": "0.42.1",
  "main": "./dist/main.js",
  "author": "Myoxus Contributors",
  "repository": {
    "url": "https://github.com/superions/myoxus",
    "type": "git"
  },
  "description": "Myoxus Desktop App",
  "homepage": "https://github.com/superions/myoxus",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env DEV_SERVER_URL=http://localhost:8080 yarn run -T r ./scripts/dev.ts",
    "dev:prod": "yarn run -T r ./scripts/dev.ts",
    "build": "cross-env NODE_ENV=production yarn run -T r ./scripts/build-layers.ts",
    "build:dev": "yarn run -T r ./scripts/build-layers.ts",
    "native:check": "yarn run -T r ./scripts/ensure-native-bindings.ts",
    "native:ensure": "yarn run -T r ./scripts/ensure-native-bindings.ts --build-missing",
    "package": "yarn run -T r ./scripts/stage-package.ts",
    "make": "yarn run -T r ./scripts/packaging/desktop.ts",
    "check:macos-arm64-output": "yarn run -T r ./scripts/macos-arm64-output-check.ts",
    "make-linux": "yarn run -T r ./scripts/packaging/linux.ts",
    "make-nsis": "yarn run -T r ./scripts/packaging/windows-nsis.ts"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@myoxus-tools/utils": "workspace:*",
    "@myoxus/crypto": "workspace:*",
    "@myoxus/i18n": "workspace:*",
    "@myoxus/infra": "workspace:*",
    "@myoxus/local-store": "workspace:*",
    "@myoxus/media-capture": "workspace:*",
    "@myoxus/storage": "workspace:*",
    "@sentry/bundler-plugins": "10.75.0",
    "@sentry/electron": "7.20.0",
    "builder-util-runtime": "9.7.0",
    "cross-env": "^10.1.0",
    "electron": "45.3.0",
    "electron-log": "5.4.4",
    "esbuild": "0.28.2",
    "lodash-es": "4.18.1",
    "nanoid": "6.0.1",
    "rxjs": "^7.8.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@myoxus/desktop-api-contract": "workspace:*",
    "async-call-rpc": "^6.4.2",
    "electron-updater": "6.8.9",
    "semver": "7.8.5",
    "set-cookie-parser": "3.1.2",
    "yaml": "2.9.1",
    "yjs": "patch:yjs@npm%3A13.6.32#~/.yarn/patches/yjs-npm-13.6.32-abd1e6b538.patch"
  },
  "license": "MIT AND AGPL-3.0-or-later"
}
