# Note: tsc --build output goes to dist/ via declarationDir setting.
# No need to ignore .d.ts in src/ — hand-written declarations live there.
build/server/data/
build/server/runtime-config/
build/server/mail-templates/
build/server/templates/
build/server/runtime-secrets/

.env
.env.*
*.cookie
*.cookies
*.key

# Standalone acceptance artifacts are not repository sources.
/todo/assets/*evidence*/
/todo/assets/preview-cache-*/
/todo/assets/mermaid-phase-3d-after-*/
/todo/assets/mermaid-phase-3e-final-*.png
/learnings/archive/*acceptance_report.md
/learnings/screenshots/
/.private/handbook/export-evidence.json

# Reviewed upstream distribution, including its otherwise ignored out/ tree.
!/.yarn/vendor/electron-updater/out/
!/.yarn/vendor/electron-updater/out/**
